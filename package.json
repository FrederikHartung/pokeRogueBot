{
  "private": true,
  "scripts": {
    "build:js": "node build-js.mjs",
    "rl:dump:starters": "node scripts/dump-pokerogue-starter-defaults.mjs",
    "rl:collect": "node scripts/run-pokerogue-experience-collector.mjs",
    "rl:gen:scenarios": "node scripts/run-wave-library-scenario-adapter.mjs",
    "rl:gen:scenarios:wave-lib": "node scripts/run-wave-library-scenario-adapter.mjs",
    "rl:collect:wave-lib:smoke": "node scripts/run-pokerogue-experience-collector.mjs ./data/rl/collector-run-wave-library-v2-smoke.json",
    "rl:collect:wave-lib:rival-smoke": "node scripts/run-pokerogue-experience-collector.mjs ./data/rl/collector-run-wave-library-v2-rival-smoke.json",
    "rl:collect:wave-lib:regression": "node scripts/run-wave-library-regression-collector.mjs",
    "rl:collect:wave-lib:train:broad-shallow": "node scripts/run-wave-library-broad-shallow-training-collector.mjs",
    "rl:collect:wave-lib:train:deep": "node scripts/run-wave-library-deep-training-collector.mjs",
    "rl:collect:bench": "node scripts/run-pokerogue-experience-collector.mjs ./data/rl/collector-run-benchmarked-wave-library-v2.json",
    "rl:collect:bench:wave-lib:v2": "node scripts/run-pokerogue-experience-collector.mjs ./data/rl/collector-run-benchmarked-wave-library-v2.json",
    "rl:check:dataset": "node scripts/run-rl-dataset-sanity.mjs",
    "rl:train:dqn:poc": "python3 scripts/train_dqn_offline.py --config ./data/rl/train-dqn-offline-poc.json",
    "rl:train:dqn:wave-lib:v2": "python3 scripts/train_dqn_offline.py --config ./data/rl/train-dqn-offline-wave-library-v2-deep.json",
    "rl:eval:dqn:poc": "python3 scripts/eval_dqn_policy.py",
    "rl:eval:compare": "python3 scripts/eval_policy_compare.py",
    "rl:eval:compare:wave-lib:v2": "python3 scripts/eval_policy_compare.py --collector-config ./data/rl/collector-run-benchmarked-wave-library-v2.json --report-path ./data/rl/combat/eval-policy-compare-wave-library-v2-report.json",
    "rl:eval:compare:wave-lib:v2:deep": "python3 scripts/eval_policy_compare.py --collector-config ./data/rl/collector-run-benchmarked-wave-library-v2.json --checkpoint ./data/rl/models/dqn-combat-wave-library-v2-deep.pt --report-path ./data/rl/combat/eval-policy-compare-wave-library-v2-deep-report.json",
    "rl:inspect:dataset": "python3 -m streamlit run scripts/streamlit_rl_dataset_inspector.py"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
