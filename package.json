{
  "private": true,
  "scripts": {
    "build:js": "node build-js.mjs",
    "rl:poc:experience": "node scripts/run-pokerogue-experience-poc.mjs",
    "rl:dump:starters": "node scripts/dump-pokerogue-starter-defaults.mjs",
    "rl:collect": "node scripts/run-pokerogue-experience-collector.mjs",
    "rl:collect:batched": "node scripts/run-pokerogue-experience-collector-batched.mjs",
    "rl:gen:scenarios": "node scripts/run-pokerogue-scenario-generator.mjs",
    "rl:collect:bench": "node scripts/run-pokerogue-experience-collector.mjs ./data/rl/collector-run-benchmarked-mixed.json",
    "rl:collect:500": "node scripts/run-pokerogue-experience-collector.mjs ./data/rl/collector-run-500-smoke.json",
    "rl:collect:5k": "node scripts/run-pokerogue-experience-collector.mjs ./data/rl/collector-run-5k-bootstrap.json",
    "rl:collect:5k:lead-1hp": "node scripts/run-pokerogue-experience-collector.mjs ./data/rl/collector-run-5k-lead-1hp.json",
    "rl:collect:5k:lead-1hp:batched": "node scripts/run-pokerogue-experience-collector-batched.mjs ./data/rl/collector-run-5k-lead-1hp.json 30",
    "rl:collect:bench:lead-1hp": "node scripts/run-pokerogue-experience-collector.mjs ./data/rl/collector-run-benchmarked-lead-1hp.json",
    "rl:check:dataset": "node scripts/run-rl-dataset-sanity.mjs",
    "rl:train:dqn:poc": "python3 scripts/train_dqn_offline.py --config ./data/rl/train-dqn-offline-poc.json",
    "rl:train:dqn:lead-1hp": "python3 scripts/train_dqn_offline.py --config ./data/rl/train-dqn-offline-lead-1hp.json",
    "rl:eval:dqn:poc": "python3 scripts/eval_dqn_policy.py",
    "rl:eval:compare": "python3 scripts/eval_policy_compare.py",
    "rl:eval:compare:lead-1hp": "python3 scripts/eval_policy_compare.py --collector-config ./data/rl/collector-run-benchmarked-lead-1hp.json --checkpoint ./data/rl/models/dqn-combat-5k-lead-1hp.pt --report-path ./data/rl/combat/eval-policy-compare-5k-lead-1hp-report.json",
    "rl:inspect:dataset": "python3 -m streamlit run scripts/streamlit_rl_dataset_inspector.py"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
