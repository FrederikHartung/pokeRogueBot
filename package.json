{
  "private": true,
  "scripts": {
    "build:js": "node build-js.mjs",
    "rl:poc:experience": "node scripts/run-pokerogue-experience-poc.mjs",
    "rl:dump:starters": "node scripts/dump-pokerogue-starter-defaults.mjs",
    "rl:collect": "node scripts/run-pokerogue-experience-collector.mjs",
    "rl:gen:scenarios": "node scripts/run-pokerogue-scenario-generator.mjs",
    "rl:collect:bench": "node scripts/run-pokerogue-experience-collector.mjs ./data/rl/collector-run-benchmarked-mixed.json",
    "rl:check:dataset": "node scripts/run-rl-dataset-sanity.mjs",
    "rl:train:dqn:poc": "python3 scripts/train_dqn_offline.py --config ./data/rl/train-dqn-offline-poc.json",
    "rl:eval:dqn:poc": "python3 scripts/eval_dqn_policy.py",
    "rl:eval:compare": "python3 scripts/eval_policy_compare.py",
    "rl:inspect:dataset": "python3 -m streamlit run scripts/streamlit_rl_dataset_inspector.py"
