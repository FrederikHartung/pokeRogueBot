{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfh.dev/pokerogue/rl-schema/modifier-transition-v1.schema.json",
  "title": "ModifierTransitionV1",
  "description": "ENTWURF modifier-v1 (siehe docs/modifier-state-v1-draft.md). Eine Zeile pro Entscheidung in der SelectModifierPhase. Ersetzt als Step-Inhalt das freie Objekt modifier_decision im Strategic-Collector-Output und ist der state-Teil von modifier_training_transition. Noch nicht verbindlich.",
  "type": "object",
  "required": [
    "schema_version",
    "decision_stage",
    "state",
    "candidates",
    "selected_candidate_index",
    "immediate_reward"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "modifier-v1"
    },
    "decision_stage": {
      "description": "shop: Kaufschleife (Phase bleibt nach Kauf offen). reward: Wahl der Gratis-Belohnung bzw. Reroll/Skip (beendet die Phase ausser bei Reroll).",
      "enum": ["shop", "reward"]
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "candidates": {
      "description": "Alle Kandidaten dieser Entscheidung, inklusive maskierter (mask=0) fuer Debugging. Das Modell bewertet nur mask=1.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "selected_candidate_index": {
      "type": "integer",
      "minimum": 0
    },
    "immediate_reward": {
      "type": "number"
    }
  },
  "$defs": {
    "status_effect": {
      "description": "StatusEffect 0..6 (NONE, POISON, TOXIC, PARALYSIS, SLEEP, FREEZE, BURN), wie combat-v4.",
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "type_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18
      }
    },
    "run_context": {
      "type": "object",
      "required": [
        "wave_index",
        "money",
        "reroll_cost",
        "reroll_count",
        "lock_rarities",
        "shop_available",
        "waves_until_next_trainer",
        "waves_until_next_fixed_battle",
        "waves_until_next_boss"
      ],
      "additionalProperties": false,
      "properties": {
        "wave_index": {
          "type": "integer",
          "minimum": 1
        },
        "money": {
          "type": "integer",
          "minimum": 0
        },
        "reroll_cost": {
          "description": "getRerollCost(lockModifierTiers); -1, wenn Reroll in dieser Phase deaktiviert ist.",
          "type": "integer",
          "minimum": -1
        },
        "reroll_count": {
          "type": "integer",
          "minimum": 0
        },
        "lock_rarities": {
          "type": "integer",
          "enum": [0, 1]
        },
        "shop_available": {
          "description": "0 auf Waves mit waveIndex % 10 == 0 (Shop leer).",
          "type": "integer",
          "enum": [0, 1]
        },
        "waves_until_next_trainer": {
          "description": "Abstand zur naechsten Wave mit gameMode.isWaveTrainer, bei 30 gekappt.",
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "waves_until_next_fixed_battle": {
          "description": "Abstand zur naechsten gameMode.isFixedBattle-Wave (Rivale, Evil-Team, Elite), bei 30 gekappt.",
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "waves_until_next_boss": {
          "description": "Abstand zur naechsten Boss-Wave (waveIndex % 10 == 0), 1..10.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "party_slot": {
      "type": "object",
      "required": [
        "present",
        "fainted",
        "hp_ratio",
        "level",
        "level_ratio_to_cap",
        "status",
        "types",
        "move_count",
        "min_pp_ratio",
        "held_item_stacks",
        "can_evolve_by_item"
      ],
      "additionalProperties": false,
      "properties": {
        "present": {
          "type": "integer",
          "enum": [0, 1]
        },
        "fainted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "hp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "level_ratio_to_cap": {
          "description": "level / globalScene.getMaxExpLevel(); 0 fuer leere Slots.",
          "type": "number",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/status_effect"
        },
        "types": {
          "$ref": "#/$defs/type_ids"
        },
        "move_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "min_pp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "held_item_stacks": {
          "description": "Summe der Stacks aller PokemonHeldItemModifier dieses Pokemon.",
          "type": "integer",
          "minimum": 0
        },
        "can_evolve_by_item": {
          "description": "1, wenn eine Item-Entwicklung fuer das aktuelle Level/die Form existiert (pokemonEvolutions mit item).",
          "type": "integer",
          "enum": [0, 1]
        }
      }
    },
    "inventory": {
      "type": "object",
      "required": [
        "pokeball_counts",
        "persistent_modifier_stacks",
        "lure_waves_remaining",
        "temp_battle_booster_waves_remaining"
      ],
      "additionalProperties": false,
      "properties": {
        "pokeball_counts": {
          "description": "globalScene.pokeballCounts in der Reihenfolge POKEBALL, GREAT_BALL, ULTRA_BALL, ROGUE_BALL, MASTER_BALL.",
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "persistent_modifier_stacks": {
          "description": "Stack-Anzahl globaler Run-Modifier (0, wenn nicht vorhanden).",
          "type": "object",
          "required": [
            "EXP_SHARE",
            "EXP_CHARM",
            "SUPER_EXP_CHARM",
            "AMULET_COIN",
            "CANDY_JAR",
            "BERRY_POUCH",
            "HEALING_CHARM",
            "CATCHING_CHARM",
            "LOCK_CAPSULE",
            "MEGA_BRACELET",
            "DYNAMAX_BAND",
            "TERA_ORB"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "lure_waves_remaining": {
          "description": "Restdauer aktiver DoubleBattleChanceBoosterModifier (Lures), 0 wenn keiner aktiv.",
          "type": "integer",
          "minimum": 0
        },
        "temp_battle_booster_waves_remaining": {
          "description": "Maximale Restdauer aktiver X-Items / Dire Hit, 0 wenn keiner aktiv.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "run",
        "party_slots",
        "inventory"
      ],
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/run_context"
        },
        "party_slots": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/party_slot"
          }
        },
        "inventory": {
          "$ref": "#/$defs/inventory"
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "kind",
        "mask"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "buy_shop_item und finish_shop nur in decision_stage=shop; take_reward, reroll, toggle_lock_rarities und skip nur in decision_stage=reward.",
          "enum": ["buy_shop_item", "finish_shop", "take_reward", "reroll", "toggle_lock_rarities", "skip"]
        },
        "mask": {
          "type": "integer",
          "enum": [0, 1]
        },
        "mask_reason": {
          "description": "Grund fuer mask=0, z. B. insufficient_money, no_injured_pokemon, skip_while_free_reward, blocked_by_offline_modifier_policy:<grund>.",
          "type": "string"
        },
        "reward_index": {
          "type": "integer",
          "minimum": 0
        },
        "shop_row_index": {
          "type": "integer",
          "minimum": 0
        },
        "shop_column_index": {
          "type": "integer",
          "minimum": 0
        },
        "item_id": {
          "description": "Pool-ID (ModifierType.id), z. B. BERRY, TM_COMMON, EXP_SHARE.",
          "type": "string"
        },
        "item_family": {
          "description": "Grobe Wirkungsfamilie fuer das Encoding (feste Liste, siehe Doku).",
          "enum": [
            "heal_hp",
            "heal_status",
            "revive",
            "revive_all",
            "pp_restore",
            "pp_up",
            "level_up",
            "level_up_all",
            "base_stat_booster",
            "temp_battle_booster",
            "attack_type_booster",
            "held_item",
            "berry",
            "evolution",
            "form_change",
            "nature",
            "tm",
            "remember_move",
            "ball",
            "lure",
            "money",
            "money_multiplier",
            "exp_booster",
            "exp_share",
            "level_booster",
            "berry_pouch",
            "charm",
            "voucher",
            "battle_gimmick",
            "lock_capsule",
            "map",
            "fusion",
            "iv_scanner",
            "other"
          ]
        },
        "variant": {
          "description": "Konkrete Variante generierter Items: stat (BASE_STAT_BOOSTER, TEMP_STAT_STAGE_BOOSTER), move_type (ATTACK_TYPE_BOOSTER), berry_type (BERRY), nature (MINT), move_id (TM_*), evolution_item (EVOLUTION_ITEM), form_change_item. Leer bei nicht generierten Items.",
          "type": "object",
          "additionalProperties": {
            "type": ["integer", "string"]
          }
        },
        "tier": {
          "description": "ModifierTier 0 COMMON .. 4 MASTER; -1 fuer Nicht-Item-Kandidaten.",
          "type": "integer",
          "minimum": -1,
          "maximum": 4
        },
        "upgrade_count": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "description": "Tatsaechliche Kosten inkl. HealShopCostModifier; 0 fuer Gratis-Belohnungen, Reroll-Kosten bei reroll.",
          "type": "integer",
          "minimum": 0
        },
        "target_party_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "target_move_index": {
          "description": "Fuer Ether/Max Ether/PP Up/PP Max bzw. die zu ersetzende Attacke bei TMs.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "target_current_stacks": {
          "description": "Vorhandene Stacks desselben Items auf dem Ziel (Held Items) bzw. global.",
          "type": "integer",
          "minimum": 0
        },
        "target_max_stacks": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
