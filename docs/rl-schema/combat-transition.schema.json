{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/combat-transition.schema.json",
  "title": "CombatTransition",
  "type": "object",
  "required": [
    "episode_id",
    "step_index",
    "state",
    "action",
    "reward",
    "next_state",
    "done",
    "meta",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "$ref": "#/$defs/observation"
    },
    "action": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "reward": {
      "type": "number"
    },
    "next_state": {
      "$ref": "#/$defs/observation"
    },
    "done": {
      "type": "boolean"
    },
    "meta": {
      "type": "object",
      "required": [
        "seed",
        "wave",
        "battle_type"
      ],
      "additionalProperties": true,
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "wave": {
          "type": "integer",
          "minimum": 1
        },
        "battle_type": {
          "type": "string",
          "enum": [
            "single"
          ]
        }
      }
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "move_state": {
      "type": "object",
      "required": [
        "move_id",
        "pp_left",
        "pp_max",
        "power",
        "accuracy"
      ],
      "additionalProperties": false,
      "properties": {
        "move_id": {
          "type": "integer",
          "minimum": 0
        },
        "pp_left": {
          "type": "integer",
          "minimum": 0
        },
        "pp_max": {
          "type": "integer",
          "minimum": 0
        },
        "power": {
          "type": "number",
          "minimum": 0
        },
        "accuracy": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "wave_index",
        "turn_index",
        "player_hp_ratio",
        "enemy_hp_ratio",
        "player_level",
        "enemy_level",
        "moves",
        "action_mask"
      ],
      "additionalProperties": false,
      "properties": {
        "wave_index": {
          "type": "integer",
          "minimum": 1
        },
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "player_hp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "enemy_hp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "player_level": {
          "type": "integer",
          "minimum": 1
        },
        "enemy_level": {
          "type": "integer",
          "minimum": 1
        },
        "moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/move_state"
          }
        },
        "action_mask": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      }
    }
  }
}
