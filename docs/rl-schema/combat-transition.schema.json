{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/combat-transition.schema.json",
  "title": "CombatTransition",
  "description": "Verbindlicher Combat-State-Contract combat-v4 (docs/combat-state-v4.md). Obermenge von combat-v3 (archiviert: combat-transition-v3.schema.json): alle v3-Felder behalten ihre Semantik, neue Felder kommen hinzu. Erzeugt vom gemeinsamen Builder src/main/ts/lib/combat-observation.ts.",
  "type": "object",
  "required": [
    "episode_id",
    "step_index",
    "state",
    "action",
    "reward",
    "next_state",
    "done",
    "meta",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "$ref": "#/$defs/observation"
    },
    "action": {
      "description": "0..3 Attacken-Slot, 4..9 Party-Slot (4 + Slot-Index). Bei decision_kind=2 (check_switch) bedeutet der Slot des aktiven Pokemon 'nicht wechseln'.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "reward": {
      "type": "number"
    },
    "next_state": {
      "$ref": "#/$defs/observation"
    },
    "done": {
      "type": "boolean"
    },
    "meta": {
      "type": "object",
      "required": [
        "seed",
        "wave",
        "battle_type",
        "state_schema_version"
      ],
      "additionalProperties": true,
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "wave": {
          "type": "integer",
          "minimum": 1
        },
        "battle_type": {
          "type": "string",
          "enum": [
            "single"
          ]
        },
        "state_schema_version": {
          "type": "string",
          "const": "combat-v4"
        },
        "outcome": {
          "description": "Nur bei done=true gesetzt; battle_ended = Kampf ohne Sieg/Niederlage beendet (z. B. Flucht des Gegners).",
          "type": ["string", "null"],
          "enum": ["win", "loss", "timeout", "truncated", "battle_ended", null]
        },
        "action_source": {
          "type": "string",
          "enum": [
            "random",
            "scheduled_random",
            "first_valid",
            "external_command",
            "model",
            "unknown"
          ]
        }
      }
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "status_effect": {
      "description": "Nicht-fluechtiger Status nach StatusEffect im Spiel: 0 NONE, 1 POISON, 2 TOXIC, 3 PARALYSIS, 4 SLEEP, 5 FREEZE, 6 BURN. FAINT wird nicht als Status kodiert (dafuer gibt es fainted bzw. hp_ratio).",
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "stat_stages": {
      "description": "Stat-Stufen in der Reihenfolge ATK, DEF, SPATK, SPDEF, SPD, ACC, EVA (BATTLE_STATS im Spiel), jeweils -6..6.",
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "integer",
        "minimum": -6,
        "maximum": 6
      }
    },
    "type_ids": {
      "description": "Aktuelle Typen (Pokemon.getTypes, inkl. Tera/Typwechsel), PokemonType 0..18 (NORMAL..STELLAR).",
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18
      }
    },
    "volatile_state": {
      "description": "Fluechtige Zustaende (BattlerTags) eines aktiven Pokemon.",
      "type": "object",
      "required": [
        "confused",
        "seeded",
        "substitute",
        "trapped",
        "locked_into_move",
        "taunted",
        "infatuated",
        "drowsy",
        "perish_song"
      ],
      "additionalProperties": false,
      "properties": {
        "confused": {
          "type": "integer",
          "enum": [0, 1]
        },
        "seeded": {
          "type": "integer",
          "enum": [0, 1]
        },
        "substitute": {
          "type": "integer",
          "enum": [0, 1]
        },
        "trapped": {
          "description": "Pokemon.isTrapped(): Wechsel nicht moeglich (TRAPPED, BIND, WRAP, Faehigkeiten wie Shadow Tag).",
          "type": "integer",
          "enum": [0, 1]
        },
        "locked_into_move": {
          "description": "RECHARGING, CHARGING, FRENZY oder ENCORE aktiv.",
          "type": "integer",
          "enum": [0, 1]
        },
        "taunted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "infatuated": {
          "type": "integer",
          "enum": [0, 1]
        },
        "drowsy": {
          "type": "integer",
          "enum": [0, 1]
        },
        "perish_song": {
          "type": "integer",
          "enum": [0, 1]
        }
      }
    },
    "battler_state": {
      "description": "Zusatzzustand eines aktiven Pokemon (eigenes oder gegnerisches).",
      "type": "object",
      "required": [
        "status",
        "stat_stages",
        "volatile"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/status_effect"
        },
        "stat_stages": {
          "$ref": "#/$defs/stat_stages"
        },
        "volatile": {
          "$ref": "#/$defs/volatile_state"
        }
      }
    },
    "enemy_state": {
      "type": "object",
      "required": [
        "status",
        "stat_stages",
        "volatile",
        "types",
        "remaining_team_count",
        "team_hp_ratio"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/status_effect"
        },
        "stat_stages": {
          "$ref": "#/$defs/stat_stages"
        },
        "volatile": {
          "$ref": "#/$defs/volatile_state"
        },
        "types": {
          "$ref": "#/$defs/type_ids"
        },
        "remaining_team_count": {
          "description": "Nicht besiegte Gegner inklusive des aktiven (Wildkampf: 1).",
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "team_hp_ratio": {
          "description": "Summe HP / Summe Max-HP ueber das ganze Gegnerteam (gleiche Groesse wie im Reward).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "side_conditions": {
      "description": "Arena-Tags auf einer Seite des Feldes.",
      "type": "object",
      "required": [
        "spikes_layers",
        "toxic_spikes_layers",
        "stealth_rock",
        "sticky_web",
        "reflect",
        "light_screen",
        "aurora_veil",
        "tailwind"
      ],
      "additionalProperties": false,
      "properties": {
        "spikes_layers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "toxic_spikes_layers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "stealth_rock": {
          "type": "integer",
          "enum": [0, 1]
        },
        "sticky_web": {
          "type": "integer",
          "enum": [0, 1]
        },
        "reflect": {
          "type": "integer",
          "enum": [0, 1]
        },
        "light_screen": {
          "type": "integer",
          "enum": [0, 1]
        },
        "aurora_veil": {
          "type": "integer",
          "enum": [0, 1]
        },
        "tailwind": {
          "type": "integer",
          "enum": [0, 1]
        }
      }
    },
    "field_state": {
      "type": "object",
      "required": [
        "weather",
        "terrain",
        "trick_room",
        "player_side",
        "enemy_side"
      ],
      "additionalProperties": false,
      "properties": {
        "weather": {
          "description": "WeatherType: 0 NONE, 1 SUNNY, 2 RAIN, 3 SANDSTORM, 4 HAIL, 5 SNOW, 6 FOG, 7 HEAVY_RAIN, 8 HARSH_SUN, 9 STRONG_WINDS.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "terrain": {
          "description": "TerrainType: 0 NONE, 1 MISTY, 2 ELECTRIC, 3 GRASSY, 4 PSYCHIC.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "trick_room": {
          "type": "integer",
          "enum": [0, 1]
        },
        "player_side": {
          "$ref": "#/$defs/side_conditions"
        },
        "enemy_side": {
          "$ref": "#/$defs/side_conditions"
        }
      }
    },
    "move_state": {
      "type": "object",
      "required": [
        "available",
        "power_bucket",
        "effectiveness_bucket",
        "stab",
        "pp_low",
        "priority_bucket",
        "acts_first_if_used",
        "can_ko_before_enemy_moves",
        "move_kind_bucket",
        "damage_class_bucket",
        "estimated_damage_ratio_bucket",
        "estimated_ko_turns_bucket",
        "accuracy_bucket",
        "uses_best_offense_stat",
        "target_immunity_risk",
        "estimated_damage_ratio",
        "pp_ratio",
        "effect_category",
        "effect_still_useful"
      ],
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "integer",
          "enum": [0, 1]
        },
        "power_bucket": {
          "description": "0 keine Staerke, 1 <=40, 2 <=70, 3 <=100, 4 >100. In v3 war maximum faelschlich 3, obwohl Collector und Kotlin 4 liefern.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "effectiveness_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "stab": {
          "type": "integer",
          "enum": [0, 1]
        },
        "pp_low": {
          "type": "integer",
          "enum": [0, 1]
        },
        "priority_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "acts_first_if_used": {
          "type": "integer",
          "enum": [0, 1]
        },
        "can_ko_before_enemy_moves": {
          "type": "integer",
          "enum": [0, 1]
        },
        "move_kind_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "damage_class_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "estimated_damage_ratio_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "estimated_ko_turns_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "accuracy_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "uses_best_offense_stat": {
          "type": "integer",
          "enum": [0, 1]
        },
        "target_immunity_risk": {
          "type": "integer",
          "enum": [0, 1]
        },
        "estimated_damage_ratio": {
          "description": "Erwarteter Schaden / Max-HP des Ziels aus der Spiel-Schadensberechnung (getAttackDamage mit simulated=true, ohne Krit), mal Trefferquote, bei 2.0 gekappt.",
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "pp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "effect_category": {
          "description": "Hauptwirkung neben Schaden: 0 nur Schaden/keine, 1 eigene Stat-Stufen hoch, 2 Gegner-Stat-Stufen runter, 3 Status zufuegen (inkl. Verwirrung), 4 Heilung, 5 Schutz (Protect/Substitute), 6 Hazard legen/entfernen, 7 Feld (Wetter/Terrain/Screens/Tailwind/Trick Room), 8 sonstige.",
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "effect_still_useful": {
          "description": "0, wenn die Hauptwirkung bereits ausgereizt ist oder sicher scheitert (z. B. Stufe schon +6/-6, Gegner hat schon Status, volle HP bei Heilung, Hazard schon gelegt, Wetter schon aktiv). Bei effect_category=0 immer 1.",
          "type": "integer",
          "enum": [0, 1]
        }
      }
    },
    "party_slot_state": {
      "type": "object",
      "required": [
        "present",
        "active",
        "fainted",
        "hp_ratio",
        "level",
        "types",
        "best_damage_into_enemy_bucket",
        "expected_incoming_damage_bucket",
        "speed_advantage_bucket",
        "survives_one_hit",
        "can_threaten_ko_bucket",
        "status",
        "is_last_switch_origin"
      ],
      "additionalProperties": false,
      "properties": {
        "present": {
          "type": "integer",
          "enum": [0, 1]
        },
        "active": {
          "type": "integer",
          "enum": [0, 1]
        },
        "fainted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "hp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "types": {
          "$ref": "#/$defs/type_ids"
        },
        "best_damage_into_enemy_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "expected_incoming_damage_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "speed_advantage_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "survives_one_hit": {
          "type": "integer",
          "enum": [0, 1]
        },
        "can_threaten_ko_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "status": {
          "$ref": "#/$defs/status_effect"
        },
        "is_last_switch_origin": {
          "description": "1, wenn dieser Slot das Pokemon haelt, das beim letzten freiwilligen Wechsel dieses Kampfes herausgenommen wurde (Grundlage der Backswitch-Strafe im Reward).",
          "type": "integer",
          "enum": [0, 1]
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "wave_index",
        "player_hp_ratio",
        "enemy_hp_ratio",
        "player_hp_bucket",
        "enemy_hp_bucket",
        "hp_diff_bucket",
        "level_gap_bucket",
        "is_trainer_battle",
        "has_legal_switch",
        "active_hp_critical",
        "bench_has_healthier_switch",
        "bench_has_better_matchup_than_active",
        "active_can_finish_enemy",
        "alive_bench_count_bucket",
        "healthy_bench_count_bucket",
        "best_switch_matchup_bucket",
        "worst_switch_risk_bucket",
        "speed_order_advantage",
        "enemy_has_known_priority_threat",
        "active_has_any_first_strike_move",
        "active_best_damage_bucket",
        "enemy_best_damage_into_active_bucket",
        "active_survives_next_hit",
        "enemy_survives_best_hit",
        "decision_kind",
        "last_action_was_switch",
        "consecutive_switch_bucket",
        "battle_turn_bucket",
        "active",
        "enemy",
        "field",
        "moves",
        "party_slots",
        "action_mask"
      ],
      "additionalProperties": false,
      "properties": {
        "wave_index": {
          "type": "integer",
          "minimum": 1
        },
        "player_hp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "enemy_hp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "player_hp_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "enemy_hp_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "hp_diff_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "level_gap_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "is_trainer_battle": {
          "type": "integer",
          "enum": [0, 1]
        },
        "has_legal_switch": {
          "type": "integer",
          "enum": [0, 1]
        },
        "active_hp_critical": {
          "type": "integer",
          "enum": [0, 1]
        },
        "bench_has_healthier_switch": {
          "type": "integer",
          "enum": [0, 1]
        },
        "bench_has_better_matchup_than_active": {
          "type": "integer",
          "enum": [0, 1]
        },
        "active_can_finish_enemy": {
          "type": "integer",
          "enum": [0, 1]
        },
        "alive_bench_count_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "healthy_bench_count_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "best_switch_matchup_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "worst_switch_risk_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "speed_order_advantage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "enemy_has_known_priority_threat": {
          "type": "integer",
          "enum": [0, 1]
        },
        "active_has_any_first_strike_move": {
          "type": "integer",
          "enum": [0, 1]
        },
        "active_best_damage_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "enemy_best_damage_into_active_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "active_survives_next_hit": {
          "type": "integer",
          "enum": [0, 1]
        },
        "enemy_survives_best_hit": {
          "type": "integer",
          "enum": [0, 1]
        },
        "decision_kind": {
          "description": "0 command (normaler Zug in der CommandPhase), 1 forced_switch (SwitchPhase nach eigenem K.O.), 2 check_switch (Wechselangebot zu Beginn eines Wildkampfs ab Wave 2, nur im Kampfstil SWITCH; CheckSwitchPhase aus EncounterPhase).",
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "last_action_was_switch": {
          "description": "1, wenn die vorige Policy-Entscheidung dieses Kampfes ein freiwilliger Wechsel war (decision_kind 0 oder 2).",
          "type": "integer",
          "enum": [0, 1]
        },
        "consecutive_switch_bucket": {
          "description": "Anzahl direkt aufeinanderfolgender freiwilliger Wechsel bis einschliesslich der vorigen Entscheidung: 0, 1, 2, 3+.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "battle_turn_bucket": {
          "description": "battle.turn: 0 Zug 1, 1 Zug 2, 2 Zuege 3-4, 3 Zuege 5-8, 4 Zug 9+.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "active": {
          "$ref": "#/$defs/battler_state"
        },
        "enemy": {
          "$ref": "#/$defs/enemy_state"
        },
        "field": {
          "$ref": "#/$defs/field_state"
        },
        "moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/move_state"
          }
        },
        "party_slots": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/party_slot_state"
          }
        },
        "action_mask": {
          "description": "decision_kind 0: wie v3. decision_kind 1: Attacken 0, nur einsetzbare Bank-Slots 1. decision_kind 2: Attacken 0, einsetzbare Bank-Slots und der aktive Slot ('bleiben') 1.",
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "enum": [0, 1]
          }
        }
      }
    }
  }
}
