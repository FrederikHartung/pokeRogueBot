{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/combat-transition.schema.json",
  "title": "CombatTransition",
  "type": "object",
  "required": [
    "episode_id",
    "step_index",
    "state",
    "action",
    "reward",
    "next_state",
    "done",
    "meta",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "$ref": "#/$defs/observation"
    },
    "action": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "reward": {
      "type": "number"
    },
    "next_state": {
      "$ref": "#/$defs/observation"
    },
    "done": {
      "type": "boolean"
    },
    "meta": {
      "type": "object",
      "required": [
        "seed",
        "wave",
        "battle_type"
      ],
      "additionalProperties": true,
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "wave": {
          "type": "integer",
          "minimum": 1
        },
        "battle_type": {
          "type": "string",
          "enum": [
            "single"
          ]
        }
      }
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "move_state": {
      "type": "object",
      "required": [
        "available",
        "power_bucket",
        "effectiveness_bucket",
        "stab",
        "pp_low"
      ],
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "integer",
          "enum": [0, 1]
        },
        "power_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "effectiveness_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "stab": {
          "type": "integer",
          "enum": [0, 1]
        },
        "pp_low": {
          "type": "integer",
          "enum": [0, 1]
        }
      }
    },
    "party_slot_state": {
      "type": "object",
      "required": [
        "present",
        "active",
        "fainted",
        "hp_ratio",
        "level",
        "types"
      ],
      "additionalProperties": false,
      "properties": {
        "present": {
          "type": "integer",
          "enum": [0, 1]
        },
        "active": {
          "type": "integer",
          "enum": [0, 1]
        },
        "fainted": {
          "type": "integer",
          "enum": [0, 1]
        },
        "hp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "types": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "wave_index",
        "player_hp_ratio",
        "enemy_hp_ratio",
        "player_hp_bucket",
        "enemy_hp_bucket",
        "hp_diff_bucket",
        "level_gap_bucket",
        "is_trainer_battle",
        "alive_bench_count_bucket",
        "healthy_bench_count_bucket",
        "best_switch_matchup_bucket",
        "worst_switch_risk_bucket",
        "moves",
        "party_slots",
        "action_mask"
      ],
      "additionalProperties": false,
      "properties": {
        "wave_index": {
          "type": "integer",
          "minimum": 1
        },
        "player_hp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "enemy_hp_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "player_hp_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "enemy_hp_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "hp_diff_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "level_gap_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "is_trainer_battle": {
          "type": "integer",
          "enum": [0, 1]
        },
        "alive_bench_count_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "healthy_bench_count_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "best_switch_matchup_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "worst_switch_risk_bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/move_state"
          }
        },
        "party_slots": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/party_slot_state"
          }
        },
        "action_mask": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      }
    }
  }
}
