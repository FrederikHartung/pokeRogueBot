{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "#enums/*": ["../../../pokerogue/src/enums/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
